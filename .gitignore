# =====================================================================
# vocab-drills .gitignore
# Rule: this repo holds ONLY code, docs and neutral sample decks.
# Personal decks, progress, tokens and notes never go into git.
# =====================================================================

# --- Secrets & credentials -------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
credentials*.json
*credentials*
secrets/
*.secret
*.secrets
*.token
*token*.json
*token*.txt
config.local.*
*.local.json

# --- Personal data (decks, progress, exports) -------------------------
# Personal decks live outside the repo; if kept locally, use private/.
private/
personal/
my-*/
data/private/
decks/private/
decks/*.private.json
*.private.json
*.personal.json
progress*.json
*-progress.json
backup*/
*.backup.json
exports/
*.export.json

# Learner notes, logs of own mistakes, raw source material
notes/
error-log*
mistakes*
journal*
sources/
transcripts/
subtitles/
*.srt
*.vtt

# --- Build & dependencies --------------------------------------------
node_modules/
dist/
build/
.cache/
coverage/
*.tsbuildinfo

# --- Logs --------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS & editors -----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
